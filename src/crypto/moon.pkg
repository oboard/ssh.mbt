  "moonbitlang/core/encoding/utf8",
}

options(
  "native-stub": [ "openssl.c" ],
  targets: {
    "digest.mbt": [ "native" ],
    "mac.mbt": [ "native" ],
    "cipher.mbt": [ "native" ],
    "kex.mbt": [ "native" ],
    "pkey.mbt": [ "native" ],
    "crypto_util.mbt": [ "native" ],
    "openssl_loader.mbt": [ "native" ],
  },
)
