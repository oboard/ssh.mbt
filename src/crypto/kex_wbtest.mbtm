// Whitebox tests for kex.mbt (DH Group14, BIGNUM helpers).
// Run `moon test --target native` to execute.

// ============== DH Group14 constants ==============

///|
test "dh_group14/prime_is_nonzero" {
  let p = dh_group14_prime()
  // The prime should be a large positive number (2048-bit)
  inspect(p > @bigint.BigInt::from_int(0), content="true")
}

///|
test "dh_group14/generator_is_2" {
  let g = dh_group14_generator()
  inspect(g.to_int(), content="2")
}

// ============== DH Group14 keygen / shared secret ==============

///|
test "dh_group14/keygen_shared_secret_agree" {
  // Two parties derive the same shared secret from their key pairs
  let x_a = @bigint.BigInt::from_int(12345)
  let x_b = @bigint.BigInt::from_int(67890)
  let (_, pub_a) = dh_group14_keygen(x_a)
  let (_, pub_b) = dh_group14_keygen(x_b)
  let shared_a = dh_group14_shared(x_a, pub_b)
  let shared_b = dh_group14_shared(x_b, pub_a)
  inspect(shared_a == shared_b, content="true")
}

///|
test "dh_group14/keygen_public_value_range" {
  // Public value g^x mod p should be in [2, p-1]
  let x = @bigint.BigInt::from_int(42)
  let p = dh_group14_prime()
  let (_, pub_val) = dh_group14_keygen(x)
  inspect(pub_val > @bigint.BigInt::from_int(1), content="true")
  inspect(pub_val < p, content="true")
}

// ============== BIGNUM helpers (OpenSSL FFI) ==============

///|
test "bn/roundtrip_bytes" {
  // bn_from_bytes -> bn_to_bytes should roundtrip
  let original = Bytes::from_array([
    b'\x00', b'\x01', b'\x02', b'\x03', b'\x04',
    b'\x05', b'\x06', b'\x07', b'\x08', b'\x09',
  ])
  let bn = bn_from_bytes(original) catch { _ => abort("bn_from_bytes failed") }
  let result = bn_to_bytes(bn, 10) catch { _ => abort("bn_to_bytes failed") }
  bn_free(bn)
  inspect(result == original, content="true")
}

///|
test "bn/num_bytes" {
  // 0x0100 = 256 -> 2 bytes
  let data = Bytes::from_array([b'\x01', b'\x00'])
  let bn = bn_from_bytes(data) catch { _ => abort("bn_from_bytes failed") }
  let n = bn_num_bytes(bn)
  bn_free(bn)
  inspect(n, content="2")
}

///|
test "bn/num_bits" {
  // 0x0100 = 256 -> 9 bits
  let data = Bytes::from_array([b'\x01', b'\x00'])
  let bn = bn_from_bytes(data) catch { _ => abort("bn_from_bytes failed") }
  let n = bn_num_bits(bn)
  bn_free(bn)
  inspect(n, content="9")
}

///|
test "bn/rand_range" {
  // Random value should be in [0, range)
  let range_bytes = Bytes::from_array([b'\x00', b'\x64']) // 100
  let range = bn_from_bytes(range_bytes) catch { _ => abort("bn_from failed") }
  let rnd = bn_rand_range(range) catch { _ => abort("bn_rand_range failed") }
  // rnd should be < range (i.e., num_bytes <= 2)
  let n = bn_num_bytes(rnd)
  inspect(n <= 2, content="true")
  bn_free(rnd)
  bn_free(range)
}

///|
test "bn/mod_exp" {
  // 3^4 mod 5 = 81 mod 5 = 1
  let a = bn_from_bytes(Bytes::from_array([b'\x03'])) catch {
    _ => abort("bn_from failed")
  }
  let p = bn_from_bytes(Bytes::from_array([b'\x04'])) catch {
    _ => abort("bn_from failed")
  }
  let m = bn_from_bytes(Bytes::from_array([b'\x05'])) catch {
    _ => abort("bn_from failed")
  }
  let r = bn_mod_exp(a, p, m) catch { _ => abort("bn_mod_exp failed") }
  let result = bn_to_bytes(r, 1) catch { _ => abort("bn_to_bytes failed") }
  bn_free(a)
  bn_free(p)
  bn_free(m)
  bn_free(r)
  inspect(result[0].to_int(), content="1")
}

///|
test "bn/to_mpint" {
  // bn_to_mpint should produce valid SSH mpint encoding
  let bn = bn_from_bytes(Bytes::from_array([b'\x01', b'\x00'])) catch {
    _ => abort("bn_from failed")
  }
  let mpint = bn_to_mpint(bn) catch { _ => abort("bn_to_mpint failed") }
  // mpint for 256 (0x0100) should have a leading zero byte (since high bit set)
  // followed by 0x01, 0x00 -> length 3
  inspect(mpint.length(), content="3")
  inspect(mpint[0].to_int(), content="0") // leading zero for positive
  inspect(mpint[1].to_int(), content="1")
  inspect(mpint[2].to_int(), content="0")
  bn_free(bn)
}
