///
/// 公钥操作封装（纯 MoonBit 实现）。
/// 使用 cc06b/mooncry/lib（Ed25519、RSA）和 Tigls/mb-p256（ECDSA P-256、ECDH）。

// ==================== Synchronous file reading FFI ====================

///|
#borrow(path, buf, out_len)
extern "C" fn read_file_ffi(
  path : Bytes,
  path_len : Int,
  buf : FixedArray[Byte],
  buf_cap : Int,
  out_len : Ref[Int],
) -> Int = "moonbitlang_ssh_read_file_sync"

// ==================== Key type ====================

///|
pub enum KeyType {
  Rsa
  Ed25519
  EcdsaP256
  Dsa
} derive(Eq, Debug)

///|
/// 公钥/私钥对象包装。
pub struct PKey {
  kt : KeyType
  // RSA: n, e, d (d empty for public-only)
  rsa_n : Bytes
  rsa_e : Bytes
  rsa_d : Bytes
  // Ed25519: seed (32 bytes, private), pub (32 bytes)
  ed_seed : Bytes
  ed_pub : Bytes
  // ECDSA P-256: priv scalar (32 bytes, empty for public-only), uncompressed pub (65 bytes)
  ec_priv : Bytes
  ec_pub : Bytes
  // DSA public components
  dsa_p : Bytes
  dsa_q : Bytes
  dsa_g : Bytes
  dsa_y : Bytes
}

///|
fn pkey_empty() -> PKey {
  {
    kt: Ed25519,
    rsa_n: b"",
    rsa_e: b"",
    rsa_d: b"",
    ed_seed: b"",
    ed_pub: b"",
    ec_priv: b"",
    ec_pub: b"",
    dsa_p: b"",
    dsa_q: b"",
    dsa_g: b"",
    dsa_y: b"",
  }
}

// ==================== Construction ====================

///|
pub fn PKey::from_rsa_components(
  n : Bytes,
  e : Bytes,
) -> PKey raise CryptoError {
  { ..pkey_empty(), kt: Rsa, rsa_n: n, rsa_e: e }
}

///|
pub fn PKey::from_dsa_components(
  p : Bytes,
  q : Bytes,
  g : Bytes,
  y : Bytes,
) -> PKey raise CryptoError {
  { ..pkey_empty(), kt: Dsa, dsa_p: p, dsa_q: q, dsa_g: g, dsa_y: y }
}

///|
pub fn PKey::from_ec_point(
  curve : String,
  point : Bytes,
) -> PKey raise CryptoError {
  if curve != "nistp256" {
    raise CryptoError::InvalidArgument(
      "only nistp256 is supported, got \{curve}",
    )
  }
  { ..pkey_empty(), kt: EcdsaP256, ec_pub: point }
}

///|
pub fn PKey::from_ed25519_pub(pub_raw : Bytes) -> PKey raise CryptoError {
  if pub_raw.length() != 32 {
    raise CryptoError::InvalidArgument("Ed25519 public key must be 32 bytes")
  }
  { ..pkey_empty(), kt: Ed25519, ed_pub: pub_raw }
}

// ==================== Key loading ====================

///|
pub fn PKey::load_private_key(path : String) -> PKey raise CryptoError {
  let content = read_file_utf8(path)
  let trimmed = trim_str(content)
  if trimmed.has_prefix("-----BEGIN OPENSSH PRIVATE KEY-----") {
    parse_openssh_private_key(trimmed)
  } else {
    raise CryptoError::OperationFailed(
      "load_private_key",
      "unsupported key format (only OpenSSH format is supported)",
    )
  }
}

///|
pub fn PKey::load_public_key(_path : String) -> PKey raise CryptoError {
  raise CryptoError::OperationFailed(
    "load_public_key",
    "use read_openssh_pubkey instead",
  )
}

// ==================== Inspection ====================

///|
pub fn PKey::close(_self : PKey) -> Unit {
  ()
}

///|
pub fn PKey::size(self : PKey) -> Int {
  match self.kt {
    Rsa => self.rsa_n.length()
    Ed25519 => 64
    EcdsaP256 => 72
    Dsa => 40
  }
}

///|
pub fn PKey::key_id(self : PKey) -> Int {
  match self.kt {
    Rsa => 6
    Dsa => 116
    EcdsaP256 => 408
    Ed25519 => 1087
  }
}

///|
pub fn PKey::ec_curve_nid(self : PKey) -> Int {
  match self.kt {
    EcdsaP256 => 415
    _ => 0
  }
}

///|
pub fn PKey::ed25519_pub_raw(self : PKey) -> Bytes raise CryptoError {
  if self.kt != Ed25519 {
    raise CryptoError::InvalidArgument("not an Ed25519 key")
  }
  self.ed_pub
}

///|
pub fn PKey::rsa_get_bn(self : PKey, name : String) -> Bytes raise CryptoError {
  if self.kt != Rsa {
    raise CryptoError::InvalidArgument("not an RSA key")
  }
  match name {
    "n" => self.rsa_n
    "e" => self.rsa_e
    _ =>
      raise CryptoError::InvalidArgument("unknown RSA param: \{name}")
  }
}

// ==================== Signing ====================

///|
pub fn PKey::sign(
  self : PKey,
  md_alg : Int,
  data : Bytes,
) -> Bytes raise CryptoError {
  match self.kt {
    Ed25519 => {
      if self.ed_seed.length() != 32 {
        raise CryptoError::InvalidArgument("Ed25519 private key (seed) not loaded")
      }
      @lib.ed25519_sign(self.ed_seed, data)
    }
    Rsa => {
      let hash = if md_alg == 1 { @lib.sha1(data) } else { @lib.sha256(data) }
      @lib.rsa_pkcs1_v15_sign(hash, self.rsa_n, self.rsa_d)
    }
    EcdsaP256 => {
      if self.ec_priv.length() != 32 {
        raise CryptoError::InvalidArgument("P-256 private key not loaded")
      }
      let hash = if md_alg == 1 { @lib.sha1(data) } else { @lib.sha256(data) }
      let priv_arr = b2u(self.ec_priv)
      let hash_fixed = b2u_fixed32(hash)
      match @p256.ecdsa_sign(priv_arr, hash_fixed) {
        Ok(sig) => ecdsa_sig_to_der(sig.r, sig.s)
        Err(e) => raise CryptoError::OperationFailed("ecdsa_sign", e)
      }
    }
    Dsa =>
      raise CryptoError::OperationFailed("sign", "DSA not supported")
  }
}

///|
pub fn PKey::rsa_sign(
  self : PKey,
  md_alg : Int,
  data : Bytes,
) -> Bytes raise CryptoError {
  self.sign(md_alg, data)
}

// ==================== Verification ====================

///|
pub fn PKey::verify(
  self : PKey,
  md_alg : Int,
  data : Bytes,
  sig : Bytes,
) -> Bool raise CryptoError {
  match self.kt {
    Ed25519 => @lib.ed25519_verify(self.ed_pub, data, sig)
    Rsa => {
      let hash = if md_alg == 1 { @lib.sha1(data) } else { @lib.sha256(data) }
      @lib.rsa_pkcs1_v15_verify(hash, sig, self.rsa_n, self.rsa_e)
    }
    EcdsaP256 => {
      let hash = if md_alg == 1 { @lib.sha1(data) } else { @lib.sha256(data) }
      let pub_arr = b2u(self.ec_pub)
      let hash_fixed = b2u_fixed32(hash)
      let (r, s) = match parse_ecdsa_sig_rs(sig) {
        Ok(rs) => rs
        Err(e) => raise CryptoError::OperationFailed("parse_ecdsa_sig", e)
      }
      let sig_obj = { r, s }
      match @p256.ecdsa_verify(pub_arr, hash_fixed, sig_obj) {
        Ok(b) => b
        Err(e) => raise CryptoError::OperationFailed("ecdsa_verify", e)
      }
    }
    Dsa => false
  }
}

// ==================== ECDH P-256 ====================

///|
pub fn ecdh_nistp256_generate() -> (PKey, Bytes) raise CryptoError {
  let priv_bytes = rand_bytes(32)
  let priv_arr = b2u(priv_bytes)
  match @p256.derive_public_key(priv_arr) {
    Ok(pub_arr) => {
      let pub_bytes = u2b(pub_arr)
      let pkey = {
        ..pkey_empty(),
        kt: EcdsaP256,
        ec_priv: priv_bytes,
        ec_pub: pub_bytes,
      }
      (pkey, pub_bytes)
    }
    Err(e) => raise CryptoError::OperationFailed("ecdh_nistp256_generate", e)
  }
}

///|
pub fn ecdh_nistp256_derive(
  our : PKey,
  peer_pub_sec1 : Bytes,
) -> Bytes raise CryptoError {
  match @p256.ecdh_bytes(our.ec_priv, peer_pub_sec1) {
    Ok(shared) => shared
    Err(e) => raise CryptoError::OperationFailed("ecdh_nistp256_derive", e)
  }
}

// ==================== OpenSSH public key file ====================

///|
pub fn read_openssh_pubkey(path : String) -> (String, Bytes) raise CryptoError {
  let content = read_file_utf8(path)
  let line = trim_str(content)
  let parts : Array[String] = []
  for part in line.split(" ") {
    let s = part.to_owned()
    if s.length() > 0 {
      parts.push(s)
    }
  }
  if parts.length() < 2 {
    raise CryptoError::OperationFailed("read_openssh_pubkey", "invalid format")
  }
  let alg = parts[0]
  let blob = base64_decode(parts[1])
  (alg, blob)
}

///|
pub fn base64_decode(s : String) -> Bytes raise CryptoError {
  let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  let table : Map[Char, Int] = {}
  for i in 0..<64 {
    let ch = alphabet.unsafe_get(i).unsafe_to_char()
    table[ch] = i
  }
  let buf : Array[Byte] = []
  let mut n = 0
  let mut bits = 0
  for c in s {
    if c == '=' || c == '\n' || c == '\r' || c == ' ' {
      continue
    }
    let v = match table[c] {
      Some(x) => x
      None =>
        raise CryptoError::OperationFailed("base64_decode", "invalid char")
    }
    n = (n << 6) | v
    bits = bits + 6
    if bits >= 8 {
      bits = bits - 8
      buf.push(((n >> bits) & 0xff).to_byte())
      n = n & ((1 << bits) - 1)
    }
  }
  Bytes::from_array(FixedArray::makei(buf.length(), i => buf[i]))
}

// ==================== OpenSSH private key parser ====================

///|
fn parse_openssh_private_key(pem : String) -> PKey raise CryptoError {
  let lines : Array[String] = []
  for line in pem.split("\n") {
    let s = trim_str(line.to_owned())
    if s.length() == 0 ||
      s.has_prefix("-----BEGIN") ||
      s.has_prefix("-----END") {
      continue
    }
    lines.push(s)
  }
  let b64 = lines.join("")
  let raw = base64_decode(b64)
  let magic = b"openssh-key-v1\x00"
  for i in 0..<magic.length() {
    if raw[i] != magic[i] {
      raise CryptoError::OperationFailed("openssh key", "invalid magic")
    }
  }
  let mut pos = magic.length()
  let (cipher, p1) = read_ssh_string(raw, pos)
  pos = p1
  let (kdf, p2) = read_ssh_string(raw, pos)
  pos = p2
  let (_, p3) = read_ssh_bytes(raw, pos)
  pos = p3
  let nkeys = read_u32_be(raw, pos)
  pos = pos + 4
  if nkeys != 1 {
    raise CryptoError::OperationFailed("openssh key", "only 1-key files supported")
  }
  if cipher != "none" || kdf != "none" {
    raise CryptoError::OperationFailed(
      "openssh key",
      "encrypted keys not yet supported (cipher=\{cipher})",
    )
  }
  let (_, p4) = read_ssh_bytes(raw, pos)
  pos = p4
  let (priv_blob, _) = read_ssh_bytes(raw, pos)
  let mut pp = 0
  let check1 = read_u32_be(priv_blob, pp)
  pp = pp + 4
  let check2 = read_u32_be(priv_blob, pp)
  pp = pp + 4
  if check1 != check2 {
    raise CryptoError::OperationFailed("openssh key", "checkint mismatch")
  }
  let (key_type, pp2) = read_ssh_string(priv_blob, pp)
  pp = pp2
  match key_type {
    "ssh-ed25519" => parse_ed25519_priv(priv_blob, pp)
    "ssh-rsa" => parse_rsa_priv(priv_blob, pp)
    "ecdsa-sha2-nistp256" => parse_ecdsa_p256_priv(priv_blob, pp)
    _ =>
      raise CryptoError::OperationFailed(
        "openssh key",
        "unsupported key type: \{key_type}",
      )
  }
}

///|
fn parse_ed25519_priv(blob : Bytes, pos : Int) -> PKey raise CryptoError {
  let (pub_bytes, p1) = read_ssh_bytes(blob, pos)
  let (priv_blob, _) = read_ssh_bytes(blob, p1)
  if pub_bytes.length() != 32 {
    raise CryptoError::OperationFailed("ed25519 parse", "invalid pub len")
  }
  if priv_blob.length() != 64 {
    raise CryptoError::OperationFailed("ed25519 parse", "invalid priv len")
  }
  let seed = slice_bytes(priv_blob, 0, 32)
  { ..pkey_empty(), kt: Ed25519, ed_seed: seed, ed_pub: pub_bytes }
}

///|
fn parse_rsa_priv(blob : Bytes, pos : Int) -> PKey raise CryptoError {
  let (n, p1) = read_ssh_bytes(blob, pos)
  let (e, p2) = read_ssh_bytes(blob, p1)
  let (d, _p3) = read_ssh_bytes(blob, p2)
  {
    ..pkey_empty(),
    kt: Rsa,
    rsa_n: strip_mpint_zero(n),
    rsa_e: strip_mpint_zero(e),
    rsa_d: strip_mpint_zero(d),
  }
}

///|
fn parse_ecdsa_p256_priv(blob : Bytes, pos : Int) -> PKey raise CryptoError {
  let (_, p1) = read_ssh_string(blob, pos)
  let (pub_point, p2) = read_ssh_bytes(blob, p1)
  let (priv_scalar, _) = read_ssh_bytes(blob, p2)
  let priv2 = strip_mpint_zero(priv_scalar)
  if priv2.length() != 32 {
    raise CryptoError::OperationFailed("ecdsa p256 parse", "scalar must be 32 bytes")
  }
  { ..pkey_empty(), kt: EcdsaP256, ec_priv: priv2, ec_pub: pub_point }
}

// ==================== SSH wire helpers ====================

///|
fn read_u32_be(b : Bytes, pos : Int) -> Int {
  b[pos].to_int().lsl(24) |
  b[pos + 1].to_int().lsl(16) |
  b[pos + 2].to_int().lsl(8) |
  b[pos + 3].to_int()
}

///|
fn read_ssh_bytes(b : Bytes, pos : Int) -> (Bytes, Int) raise CryptoError {
  if pos + 4 > b.length() {
    raise CryptoError::OperationFailed("read_ssh_bytes", "truncated length")
  }
  let len = read_u32_be(b, pos)
  let end = pos + 4 + len
  if end > b.length() {
    raise CryptoError::OperationFailed("read_ssh_bytes", "truncated data")
  }
  (slice_bytes(b, pos + 4, end), end)
}

///|
fn read_ssh_string(b : Bytes, pos : Int) -> (String, Int) raise CryptoError {
  let (bytes, p) = read_ssh_bytes(b, pos)
  let s = @utf8.decode(bytes) catch {
    _ => raise CryptoError::OperationFailed("read_ssh_string", "utf8 error")
  }
  (s, p)
}

///|
fn slice_bytes(b : Bytes, from : Int, to : Int) -> Bytes {
  Bytes::from_array(FixedArray::makei(to - from, i => b[from + i]))
}

///|
fn strip_mpint_zero(b : Bytes) -> Bytes {
  if b.length() > 0 && b[0] == b'\x00' {
    slice_bytes(b, 1, b.length())
  } else {
    b
  }
}

// ==================== ECDSA DER helpers ====================

///|
fn ecdsa_sig_to_der(r : Array[UInt], s : Array[UInt]) -> Bytes raise CryptoError {
  let r_bytes = u2b(r)
  let s_bytes = u2b(s)
  let r_der = der_integer(r_bytes)
  let s_der = der_integer(s_bytes)
  let seq_len = r_der.length() + s_der.length()
  let buf : Array[Byte] = [b'\x30']
  push_der_len(buf, seq_len)
  for b in r_der { buf.push(b) }
  for b in s_der { buf.push(b) }
  Bytes::from_array(FixedArray::makei(buf.length(), i => buf[i]))
}

///|
fn der_integer(raw : Bytes) -> Bytes {
  let need_pad = raw.length() > 0 && raw[0].to_int() >= 0x80
  let buf : Array[Byte] = [b'\x02']
  let pad_len = if need_pad { 1 } else { 0 }
  let len = raw.length() + pad_len
  push_der_len(buf, len)
  if need_pad { buf.push(b'\x00') }
  for b in raw { buf.push(b) }
  Bytes::from_array(FixedArray::makei(buf.length(), i => buf[i]))
}

///|
fn push_der_len(buf : Array[Byte], len : Int) -> Unit {
  if len < 0x80 {
    buf.push(len.to_byte())
  } else if len < 0x100 {
    buf.push(b'\x81')
    buf.push(len.to_byte())
  } else {
    buf.push(b'\x82')
    buf.push(((len >> 8) & 0xff).to_byte())
    buf.push((len & 0xff).to_byte())
  }
}

///|
fn parse_ecdsa_sig_rs(
  der : Bytes,
) -> Result[(Array[UInt], Array[UInt]), String] {
  if der.length() < 6 || der[0].to_int() != 0x30 {
    return Err("not a DER SEQUENCE")
  }
  let (_, off) = parse_der_len(der, 1)
  let mut p = off
  if der[p].to_int() != 0x02 {
    return Err("expected INTEGER for r")
  }
  p = p + 1
  let (r_len, p2) = parse_der_len(der, p)
  p = p2
  let r_raw = slice_bytes(der, p, p + r_len)
  p = p + r_len
  if der[p].to_int() != 0x02 {
    return Err("expected INTEGER for s")
  }
  p = p + 1
  let (s_len, p3) = parse_der_len(der, p)
  let s_raw = slice_bytes(der, p3, p3 + s_len)
  let r_clean = if r_raw.length() > 32 && r_raw[0] == b'\x00' {
    slice_bytes(r_raw, 1, r_raw.length())
  } else {
    r_raw
  }
  let s_clean = if s_raw.length() > 32 && s_raw[0] == b'\x00' {
    slice_bytes(s_raw, 1, s_raw.length())
  } else {
    s_raw
  }
  Ok((pad32(r_clean), pad32(s_clean)))
}

///|
fn parse_der_len(b : Bytes, pos : Int) -> (Int, Int) {
  let first = b[pos].to_int()
  if first < 0x80 {
    (first, pos + 1)
  } else if first == 0x81 {
    (b[pos + 1].to_int(), pos + 2)
  } else {
    (b[pos + 1].to_int().lsl(8) | b[pos + 2].to_int(), pos + 3)
  }
}

///|
fn pad32(b : Bytes) -> Array[UInt] {
  let arr : Array[UInt] = []
  for _ in 0..<(32 - b.length()) { arr.push(0U) }
  for byte in b { arr.push(byte.to_int().reinterpret_as_uint()) }
  arr
}

// ==================== Byte/UInt conversions ====================

///|
fn b2u(b : Bytes) -> Array[UInt] {
  let arr : Array[UInt] = []
  for byte in b { arr.push(byte.to_int().reinterpret_as_uint()) }
  arr
}

///|
fn u2b(arr : Array[UInt]) -> Bytes {
  Bytes::from_array(FixedArray::makei(arr.length(), i => (arr[i] & 0xFFU).to_byte()))
}

///|
fn b2u_fixed32(b : Bytes) -> FixedArray[UInt] {
  let arr = FixedArray::make(32, 0U)
  let off = 32 - b.length()
  for i in 0..<b.length() {
    arr[off + i] = b[i].to_int().reinterpret_as_uint()
  }
  arr
}

// ==================== File reading ====================

///|
fn read_file_utf8(path : String) -> String raise CryptoError {
  let path_b = @utf8.encode(path)
  let cap = 65536
  let buf = FixedArray::make(cap, b'\x00')
  let out_len = Ref(0)
  let rc = read_file_ffi(path_b, path_b.length(), buf, cap, out_len)
  if rc != 1 {
    raise CryptoError::OperationFailed("read_file", "cannot open \{path}")
  }
  let arr = FixedArray::makei(out_len.val, i => buf.unsafe_get(i))
  @utf8.decode(Bytes::from_array(arr)) catch {
    _ => raise CryptoError::OperationFailed("read_file", "utf8 decode error")
  }
}

///|
fn trim_str(s : String) -> String {
  let arr = s.to_array()
  let mut start = 0
  let mut end = arr.length()
  while start < end {
    let c = arr.unsafe_get(start)
    if c == ' ' || c == '\t' || c == '\r' || c == '\n' {
      start = start + 1
    } else {
      break
    }
  }
  while end > start {
    let c = arr.unsafe_get(end - 1)
    if c == ' ' || c == '\t' || c == '\r' || c == '\n' {
      end = end - 1
    } else {
      break
    }
  }
  let sb = StringBuilder::new()
  for i = start; i < end; i = i + 1 {
    sb.write_char(arr.unsafe_get(i))
  }
  sb.to_string()
}
